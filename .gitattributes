# Auto detect text files and perform LF normalization
* text=auto

# Unity YAML(프리팹·씬·에셋)은 텍스트 3-way 머지로 합치면 중첩 프리팹 오버라이드가
# 뒤섞여 조용히 깨진다. UnityYAMLMerge(SmartMerge)가 fileID 단위로 합치게 한다.
#
# ⚠ merge=unityyamlmerge도 드라이버 등록이 있어야 동작한다. 클론한 사람마다 1회:
#     git config merge.unityyamlmerge.name "Unity SmartMerge"
#     git config merge.unityyamlmerge.driver '"C:/Program Files/Unity/Hub/Editor/6000.3.10f1/Editor/Data/Tools/UnityYAMLMerge.exe" merge -p %O %B %A %A'
#     git config merge.unityyamlmerge.recursive binary
#   등록 안 하면 예전처럼 텍스트 머지로 처리될 뿐 즉시 손상되지는 않는다.
*.prefab merge=unityyamlmerge
*.unity  merge=unityyamlmerge
*.asset  merge=unityyamlmerge

# TMP 동적 폰트 에셋 — 에디터에서 플레이할 때마다 화면에 뜬 글자가 아틀라스 캐시로 파일에 적힌다.
# 34MB짜리가 사람마다 다르게 자라 매 머지 충돌하는데, 정작 빌드에는 쓸모가 없다
# (전부 m_ClearDynamicDataOnBuild: 1 — 빌드가 지우고 런타임이 다시 채운다).
# 그래서 병합하지 않고 현재 브랜치 것을 그대로 둔다. 빠진 글리프는 알아서 다시 채워진다.
#
#   -text       : 34MB 파일에 줄바꿈 정규화를 걸지 않는다(느리고 의미 없다)
#   merge=ours  : 충돌 없이 현재 브랜치 버전 채택
#
# ⚠ merge=ours는 드라이버 등록이 있어야 동작한다. 클론한 사람마다 1회:
#     git config merge.ours.driver true
#   등록 안 하면 예전처럼 충돌만 날 뿐 손상되지는 않는다.
# ⚠ 이 두 줄은 위의 *.asset 규칙보다 뒤에 있어야 한다 — gitattributes는 마지막 일치가 이긴다.
Assets/Fonts/**/*.asset          -text merge=ours
Assets/Resources/Fonts/*.asset   -text merge=ours

# Unity prefab YAML must use Smart Merge to keep nested-prefab edits reviewable.
*.prefab merge=unityyamlmerge

# Cloud Functions 소스는 ESLint linebreak-style(LF)을 강제한다 —
# Windows 체크아웃에서 CRLF로 떨어지면 predeploy lint가 전 파일에서 터진다.
functions/** text eol=lf
