# Cloud Run 전투 재생 서비스의 기본 URL. 런타임 호출 여부의 진실원은
# envs/{envId}/config/battleReplay.enabled 이며 문서가 없으면 off다.
# URL이 비었는데 토글을 켜면 ruleset 2 이상 매치는 replayUnavailable 상태로 pending에 남는다.
# 배포 환경마다 다른 서비스를 쓸 때는 Firebase의 프로젝트별 .env.<project-id>에서 덮어쓴다.
BATTLE_REPLAY_URL=https://battle-replay-zy5ccormuq-du.a.run.app
