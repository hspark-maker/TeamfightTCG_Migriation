rules_version = '2';

// =====================================================================
// 개발용 임시 규칙 — 전면 개방. 절대 운영 프로젝트에 배포하지 말 것.
// 실제 규칙은 firestore.rules.prod 에 보존되어 있다.
// 스펙 데이터 이관 툴 작업이 끝나면 .prod 를 되돌려 배포한다.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
