  playerScript:
  - kind: 1
    attackerSlot: 0
    targetSlot: 0
    guideMessage: "\uCE74\uB4DC\uB97C \uB4DC\uB798\uADF8\uD574\uC11C \uC0C1\uB300
      \uCE74\uB4DC\uB85C \uB04C\uC5B4\uB2E4 \uB193\uC73C\uBA74 \uADF8 \uCE74\uB4DC\uB97C
      \uACF5\uACA9\uD569\uB2C8\uB2E4!"
    waitForTap: 1
    dimBackground: 1
  - kind: 0
    attackerSlot: 0
    targetSlot: 0
    guideMessage: "\uBC88\uAC1C\uBFD4(\uCCB4\uB825 5)\uC744 \uB4DC\uB798\uADF8\uD574
      \uC55E\uC758 \uC218\uC815\uBFD4\uB8E8(\uCCB4\uB825 3)\uB97C \uACF5\uACA9! \uC77C\uBC18
      \uCE74\uB4DC\uB294 \uC0C1\uB300 \uCCB4\uB825\uB9CC\uD07C \uBC18\uACA9\uC744
      \uBC1B\uB294\uB2E4."
    waitForTap: 1
    dimBackground: 0
  - kind: 1
    attackerSlot: 0
    targetSlot: 0
    guideMessage: "\uBC18\uACA9! \uBC29\uAE08 \uBC88\uAC1C\uBFD4\uC774 \uC218\uC815\uBFD4\uB8E8\uC758
      \uCCB4\uB825(3)\uB9CC\uD07C \uBC18\uACA9\uC744 \uBC1B\uC544 5\u21922\uAC00
      \uB410\uB2E4. \uC77C\uBC18 \uACF5\uACA9\uC740 \uC11C\uB85C \uB2E4\uCE5C\uB2E4."
    waitForTap: 1
    dimBackground: 1
  - kind: 1
    attackerSlot: 1
    targetSlot: 1
    guideMessage: "\uD558\uC9C0\uB9CC '\uC6D0\uAC70\uB9AC(Ranged)' \uD0A4\uC6CC\uB4DC
      \uCE74\uB4DC\uB294 \uBC18\uACA9\uC744 \uBC1B\uC9C0 \uC54A\uB294\uB2E4!"
    waitForTap: 1
    dimBackground: 1
  - kind: 0
    attackerSlot: 1
    targetSlot: 1
    guideMessage: "\uD30C\uB3C4\uB9AC(\uC6D0\uAC70\uB9AC, \uCCB4\uB825 3)\uB97C \uB4DC\uB798\uADF8\uD574
      \uACF5\uACA9! \uBC18\uACA9 \uC5C6\uC774 \uC548\uC804\uD558\uAC8C \uCC98\uCE58\uD55C\uB2E4."
    waitForTap: 1
    dimBackground: 0
  - kind: 1
    attackerSlot: 1
    targetSlot: 2
    guideMessage: "\uBD24\uB098? \uD30C\uB3C4\uB9AC\uB294 \uBC18\uACA9 0 \u2014 \uCCB4\uB825
      \uADF8\uB300\uB85C 3\uC774\uB2E4. \uC6D0\uAC70\uB9AC\uB294 \uAC15\uD558\uB2E4.
      \uB9C8\uC9C0\uB9C9 \uC801\uC744 \uCC98\uCE58\uD558\uC790!"
    waitForTap: 1
    dimBackground: 1
  - kind: 0
    attackerSlot: 1
    targetSlot: 2
    guideMessage: "\uD30C\uB3C4\uB9AC(\uC6D0\uAC70\uB9AC)\uB85C \uB9C8\uC9C0\uB9C9
      \uC801\uAE4C\uC9C0 \uCC98\uCE58! \uBC18\uACA9 \uC5C6\uC774 \uC2B9\uB9AC\uD55C\uB2E4."
    waitForTap: 1
    dimBackground: 0
  enemyScript: []
