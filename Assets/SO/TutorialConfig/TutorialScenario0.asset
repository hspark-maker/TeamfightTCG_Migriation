  playerScript:
  - kind: 1
    attackerSlot: 0
    targetSlot: 0
    guideMessage: "\uAC8C\uC784\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!
      \uAE30\uBCF8 \uC870\uC791\uBC95\uC744 \uBC30\uC6CC\uBD05\uC2DC\uB2E4."
    waitForTap: 1
    dimBackground: 1
    allowedGesture: 0
  - kind: 1
    attackerSlot: 0
    targetSlot: 0
    guideMessage: "\u2460 \uBB34\uC7A5: \uB0B4 \uCE74\uB4DC\uB97C \uD0ED\uD558\uBA74
      \uBB34\uC7A5\uB429\uB2C8\uB2E4. \uBB34\uC7A5\uD55C \uCE74\uB4DC\uB9CC \uACF5\uACA9\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    waitForTap: 1
    dimBackground: 1
    allowedGesture: 0
  - kind: 0
    attackerSlot: 0
    targetSlot: 0
    guideMessage: "\uB0B4 \uCE74\uB4DC\uB97C \uD0ED\uD574 \uBB34\uC7A5\uD558\uACE0,
      \uC55E\uC758 \uC801\uC744 \uD0ED\uD574\uC11C \uACF5\uACA9\uD574\uBCF4\uC138\uC694!"
    waitForTap: 1
    dimBackground: 0
    allowedGesture: 3
  - kind: 1
    attackerSlot: 1
    targetSlot: 0
    guideMessage: "\u2461 \uB300\uC0C1 \uC120\uD0DD: \uBB34\uC7A5\uD55C \uB4A4 \uACF5\uACA9\uD560
      \uC0C1\uB300 \uCE74\uB4DC\uB97C \uD0ED\uD558\uBA74 \uADF8 \uCE74\uB4DC\uB97C
      \uACF5\uACA9\uD569\uB2C8\uB2E4."
    waitForTap: 1
    dimBackground: 1
    allowedGesture: 0
  - kind: 0
    attackerSlot: 1
    targetSlot: 0
    guideMessage: "\uB2E4\uB978 \uCE74\uB4DC\uB97C \uD0ED\uD574 \uBB34\uC7A5\uD558\uACE0,
      \uC67C\uCABD \uC801\uC744 \uD0ED\uD574\uC11C \uACF5\uACA9\uD574\uBCF4\uC138\uC694!"
    waitForTap: 1
    dimBackground: 0
    allowedGesture: 3
  - kind: 1
    attackerSlot: 2
    targetSlot: 0
    guideMessage: "\u2462 \uBB34\uC7A5 \uD574\uC81C: \uBB34\uC7A5\uD55C \uCE74\uB4DC\uB97C
      \uB2E4\uC2DC \uD0ED\uD558\uBA74 \uBB34\uC7A5\uC774 \uD480\uB9BD\uB2C8\uB2E4."
    waitForTap: 1
    dimBackground: 1
    allowedGesture: 0
  - kind: 0
    attackerSlot: 2
    targetSlot: 0
    guideMessage: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD55C \uBC88 \uB354, \uD0ED\uC73C\uB85C
      \uBB34\uC7A5\uD558\uACE0 \uC801\uC744 \uD0ED\uD574\uC11C \uACF5\uACA9\uD574\uBCF4\uC138\uC694!"
    waitForTap: 1
    dimBackground: 0
    allowedGesture: 3
  - kind: 1
    attackerSlot: 0
    targetSlot: 0
    guideMessage: "\uC870\uC791\uC744 \uBAA8\uB450 \uC775\uD614\uC5B4\uC694! \uC0C1\uB300
      \uCE74\uB4DC\uB97C \uBAA8\uB450 \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uC2B9\uB9AC\uD569\uB2C8\uB2E4.
      \uB0A8\uC740 \uC801\uC744 \uC790\uC720\uB86D\uAC8C \uACF5\uACA9\uD574 \uCC98\uCE58\uD558\uC138\uC694!"
    waitForTap: 1
    dimBackground: 1
    allowedGesture: 0
