  playerScript:
  - kind: 1
    attackerSlot: 0
    targetSlot: 0
    guideMessage: "게임에 오신 것을 환영합니다! 기본 조작법을 배워봅시다."
    waitForTap: 1
    dimBackground: 1
  - kind: 1
    attackerSlot: 0
    targetSlot: 0
    guideMessage: "① 위로 드래그: 내 카드를 위로 끌어 상대 카드에 놓으면 그 카드를 공격합니다."
    waitForTap: 1
    dimBackground: 1
  - kind: 0
    attackerSlot: 0
    targetSlot: 0
    guideMessage: "위로 드래그해서 앞의 적을 공격해보세요!"
    waitForTap: 1
    dimBackground: 0
    allowedGesture: 1
  - kind: 1
    attackerSlot: 1
    targetSlot: 0
    guideMessage: "② 아래로 드래그: 아래로 끌면 좌우 방향으로 조준되고, 놓으면 그 방향의 적을 공격합니다."
    waitForTap: 1
    dimBackground: 1
  - kind: 0
    attackerSlot: 1
    targetSlot: 0
    guideMessage: "아래로 드래그해서 왼쪽 적을 조준하고 공격해보세요!"
    waitForTap: 1
    dimBackground: 0
    allowedGesture: 2
  - kind: 1
    attackerSlot: 2
    targetSlot: 0
    guideMessage: "③ 탭: 내 카드를 탭하면 무장되고, 상대 카드를 탭하면 공격합니다."
    waitForTap: 1
    dimBackground: 1
  - kind: 0
    attackerSlot: 2
    targetSlot: 0
    guideMessage: "내 카드를 탭해 무장하고, 왼쪽 적을 탭해서 공격해보세요!"
    waitForTap: 1
    dimBackground: 0
    allowedGesture: 3
  - kind: 1
    attackerSlot: 0
    targetSlot: 0
    guideMessage: "조작을 모두 익혔어요! 상대 카드를 모두 쓰러뜨리면 승리합니다. 남은 적을 자유롭게 공격해 처치하세요!"
    waitForTap: 1
    dimBackground: 1
