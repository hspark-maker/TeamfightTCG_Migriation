  playerScript:
  - kind: 2
    attackerSlot: 0
    targetSlot: 1
    guideMessage: "\uC801 \uCE74\uB4DC\uB97C \uC190\uAC00\uB77D\uC73C\uB85C \uAE38\uAC8C
      \uB204\uB974\uBA74 \uADF8 \uCE74\uB4DC\uC758 \uC815\uBCF4(\uCCB4\uB825\xB7\uD0A4\uC6CC\uB4DC)\uB97C
      \uBCFC \uC218 \uC788\uB2E4. \uC801 '\uCCA0\uAC11\uBABD\uCE58'\uB97C \uAE38\uAC8C
      \uB20C\uB7EC \uD655\uC778\uD574\uBCF4\uC790!"
    waitForTap: 0
    dimBackground: 0
  - kind: 1
    attackerSlot: 0
    targetSlot: 1
    guideMessage: "'\uCCA0\uAC11\uBABD\uCE58'\uB294 '\uB3C4\uBC1C' \uCE74\uB4DC\uC785\uB2C8\uB2E4.
      \uC801 \uC9C4\uC601\uC5D0 \uB3C4\uBC1C\uC774 \uC788\uC73C\uBA74 \uBC18\uB4DC\uC2DC
      \uADF8 \uCE74\uB4DC\uBD80\uD130 \uACF5\uACA9\uD574\uC57C \uD569\uB2C8\uB2E4."
    waitForTap: 1
    dimBackground: 1
  - kind: 0
    attackerSlot: 0
    targetSlot: 1
    guideMessage: "\uB300\uC2E0, \uB3C4\uBC1C \uCE74\uB4DC\uB294 \uACF5\uACA9/\uBC18\uACA9\uC73C\uB85C
      \uC8FC\uB294 \uD53C\uD574\uAC00 \uBC18\uC73C\uB85C \uAC10\uC18C\uD569\uB2C8\uB2E4."
    waitForTap: 1
    dimBackground: 0
  - kind: 1
    attackerSlot: 0
    targetSlot: 0
    guideMessage: "\uBCC4\uD1A0\uB9AC\uB294 \uD790\uB7EC \uCE74\uB4DC\uC785\uB2C8\uB2E4.
      \uD790\uB7EC \uCE74\uB4DC\uB294 \uB9E4 \uD134 \uC2DC\uC791\uB9C8\uB2E4 \uC544\uAD70
      \uC804\uCCB4\uB97C 1 \uD68C\uBCF5\uC2DC\uD0B5\uB2C8\uB2E4."
    waitForTap: 1
    dimBackground: 1
  - kind: 0
    attackerSlot: 1
    targetSlot: 2
    guideMessage: "\uC6B0\uB4DC\uD63C\uC73C\uB85C \uACF5\uACA9\uD558\uC790!"
    waitForTap: 1
    dimBackground: 0
  - kind: 0
    attackerSlot: -1
    targetSlot: -1
    guideMessage: 
    waitForTap: 0
    dimBackground: 0
  - kind: 0
    attackerSlot: 2
    targetSlot: 0
    guideMessage: "\uD790\uB7EC '\uBCC4\uD1A0\uB9AC'\uB3C4 \uC9C1\uC811 \uACF5\uACA9\uD560
      \uC218 \uC788\uB2E4!"
    waitForTap: 0
    dimBackground: 0
  - kind: 0
