  playerScript:
  - kind: 1
    attackerSlot: -1
    targetSlot: -1
    guideMessage: "\uC774\uBC88 \uC804\uD22C\uC5D4 '\uC2DC\uB108\uC9C0'\uAC00 \uB4F1\uC7A5\uD569\uB2C8\uB2E4!
      \uB0B4 \uCE74\uB4DC\uB294 \uC804\uBD80 '\uBB34\uB9AC' \uC2DC\uB108\uC9C0 \uCE74\uB4DC\uC785\uB2C8\uB2E4.
      \uBB34\uB9AC \uC2DC\uB108\uC9C0\uB294 \uBB34\uB9AC \uCE74\uB4DC\uAC00 4\uC7A5\uC77C
      \uB54C \uD65C\uC131\uD654\uB429\uB2C8\uB2E4."
