    handSlot: 0
  - kind: 1
    attackerSlot: -1
    targetSlot: -1
    guideMessage: "\uBB34\uB9AC \uC2DC\uB108\uC9C0\uC758 \uD6A8\uACFC\uB294 \uACF5\uACA9\uD560
      \uB54C, \uD544\uB4DC\uC758 \uBB34\uB9AC \uC544\uAD70 \uC218\uB9CC\uD07C \uD53C\uD574\uB97C
      \uBA3C\uC800 \uC8FC\uB294 \uD6A8\uACFC\uC785\uB2C8\uB2E4. \uC9C0\uAE08 \uD544\uB4DC\uC5D0\uB294
      \uBB34\uB9AC\uAC00 3\uC7A5\uC774\uB77C \uACF5\uACA9\uB9C8\uB2E4 3\uC758 \uD53C\uD574\uB97C
      \uBA3C\uC800 \uC90D\uB2C8\uB2E4!"
