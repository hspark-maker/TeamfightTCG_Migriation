<?xml version="1.0" encoding="utf-8"?>
<!--CookApps 패키지 자동 생성 (수정하지 마세요!!)-->
<linker>
  <!--CookApps 내부 패키지-->
  <assembly fullname="AppleAuth" preserve="all" />
  <assembly fullname="CookApps.PlatformAuth" preserve="all" />
  <assembly fullname="CookApps.GoogleSignIn" preserve="all" />
  <assembly fullname="Google.Play.Games" preserve="all" />
  <assembly fullname="CookApps.SpecData" preserve="all" />
  <assembly fullname="CookApps.Inspector" preserve="all" />
  <assembly fullname="CookApps.Obfuscator" preserve="all" />
  <assembly fullname="CookApps.Code.Obfuscator" preserve="all" />
  <!--CookApps 외부 패키지-->
  <assembly fullname="CookApps.PlatformAuth">
    <type fullname="CookApps.PlatformAuth.*" preserve="all" />
  </assembly>
  <assembly fullname="UnityEngine.AndroidJNIModule">
    <type fullname="UnityEngine.AndroidJNIModule.AndroidJavaObject" preserve="all" />
  </assembly>
</linker>