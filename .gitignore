# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
# Unity 가 자동 생성하는 csproj 만 막는 규칙이다. 손으로 쓴 서버·툴 프로젝트는 추적해야 한다 —
# 빠지면 Cloud Build 컨텍스트에 안 실려 "csproj not found" 로만 드러난다(실제로 한 번 겪었다).
!Services/**/*.csproj
!Tools/**/*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Ss]erver[Dd]ata/

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*


# 개인 로컬 지침 (Claude Code)
CLAUDE.local.md

# Claude Code 개인 로컬 설정 (권한/경로는 사람마다 달라 공유 금지 — 공유 항목은 .claude/settings.json)
.claude/settings.local.json
.claude/settings.local.json.bak

# Codex 지침
.codex
.codex/
.codex_tmp/

# orch 세션 상태 (append 로그, 동시작업 충돌원)
.orch/

# orch 자동생성 경로맵 (1만+ 파일 목록, 재생성 잦음 = 충돌원. 머신별 로컬 생성)
.claude/orch-pathmap.md

# 기능 지도 SessionStart 동기화의 로컬 롤링 백업/중단 잔여물
.claude/orch-feature-map.md.bak
.claude/orch-feature-map.md*.tmp-*
.claude/agents-map-inline.bak
.claude/agents-map-inline.bak.tmp-*
AGENTS.md.tmp-*

# TMP 폰트 아틀라스 재생성물 (conflict 방지, meta는 추적 유지)
Assets/Fonts/MalgunGothic_TMP.asset
Assets/Fonts/MalgunGothic_OutlinfFont.asset

.mcp.json

# Firebase 데스크톱 네이티브 — FirebaseCppApp .bundle 이 106MB 라 GitHub 100MB 한도를 넘는다.
# .bundle=macOS 에디터, .so=Linux 에디터 전용이라 Windows 개발/Android·iOS 빌드에는 안 쓰인다.
# 해당 플랫폼에서 에디터를 돌려야 하면 같은 버전 Firebase Unity SDK 를 임포트해 복원한다.
Assets/Firebase/Plugins/x86_64/*.bundle
Assets/Firebase/Plugins/x86_64/*.bundle.meta
Assets/Firebase/Plugins/x86_64/*.so
Assets/Firebase/Plugins/x86_64/*.so.meta

# 에이전트 워크트리 (gitlink 실수 커밋 방지)
.claude/worktrees/

# Firebase CLI 배포·에뮬레이터 캐시
.firebase/
